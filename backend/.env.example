# Environment
NODE_ENV=development
PORT=8080

# Database (MySQL)
DATABASE_URL="mysql://root:password@localhost:3306/gym_track"

# JWT Authentication (JWT_SECRET must be at least 32 characters, JWT_EXPIRES_IN e.g. 7d, 24h, 3600s)
JWT_SECRET="replace_with_your_super_secret_jwt_key_32_chars_min"
JWT_EXPIRES_IN=7d

# Email Notification (Gmail SMTP)
EMAIL=your_email@gmail.com
EMAIL_APP_PASSWORD=your_gmail_app_password
